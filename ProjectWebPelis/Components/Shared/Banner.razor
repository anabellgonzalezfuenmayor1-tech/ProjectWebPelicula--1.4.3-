@inject IJSRuntime JSRuntime

<div class="base-banner" style="background-image: linear-gradient( to top, rgba(0, 0, 0, 0.75) 0%, transparent 35%, transparent 65%, rgba(0, 0, 0, 0.95) 100% ), url('@ImagenInicial')">
    @ChildContent
</div>

@code {
    [Parameter]
    public string ImagenInicial { get; set; } = "https://wallpapercave.com/wp/wp4686158.jpg";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./Components/Shared/Banner.razor.js"
            );
        }
    }
}
